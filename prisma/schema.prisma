generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Plan {
  FREE
  LIFETIME_PREMIUM
}

enum DocumentType {
  RESUME
  COVER_LETTER
}

enum PaymentStatus {
  PENDING
  PAID
  COMPLETED
  REFUNDED
  FAILED
}

model User {
  id              String               @id @default(cuid())
  name            String?
  email           String?              @unique
  emailVerified   DateTime?
  image           String?
  passwordHash    String?
  plan            Plan                 @default(FREE)
  isPremium       Boolean              @default(false)
  paddleCustomerId String?              @unique
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  accounts        Account[]
  sessions        Session[]
  profiles        BaseProfile[]
  documents       GeneratedDocument[]
  payments        PaymentTransaction[]

  @@index([plan])
}

// A user can retain several career versions (for example: engineering and marketing).
model BaseProfile {
  id          String   @id @default(cuid())
  userId      String
  label       String
  contact     Json
  summary     String?
  education   Json
  experience  Json
  skills      Json
  certifications Json?
  links       Json?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents   GeneratedDocument[]

  @@index([userId, updatedAt])
}

model GeneratedDocument {
  id              String       @id @default(cuid())
  userId          String
  baseProfileId   String
  type            DocumentType
  title           String
  targetRole      String
  companyName     String?
  jobDescription  String?
  content         Json
  model           String
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  baseProfile     BaseProfile  @relation(fields: [baseProfileId], references: [id], onDelete: Restrict)

  @@index([userId, type, createdAt])
}

model PaymentTransaction {
  id                  String        @id @default(cuid())
  userId              String
  provider            String        @default("paddle")
  externalTransactionId String?     @unique
  externalEventId     String?       @unique
  amountCents         Int           @default(2500)
  currency            String        @default("USD")
  status              PaymentStatus @default(PENDING)
  rawPayload          Json?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  paidAt              DateTime?
  user                User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  webhookEvents       PaddleWebhookEvent[]

  @@index([userId, status])
}

// Retaining event IDs makes webhook processing idempotent across delivery retries.
model PaddleWebhookEvent {
  id                   String             @id @default(cuid())
  externalEventId      String             @unique
  eventType            String
  paymentTransactionId String
  payload              Json
  receivedAt           DateTime           @default(now())
  paymentTransaction   PaymentTransaction @relation(fields: [paymentTransactionId], references: [id], onDelete: Cascade)

  @@index([paymentTransactionId])
}

// Auth.js adapter tables
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
